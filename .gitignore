.playwright-mcp/
*.png
!assets/*.png

# ---------------------------------------------------------------------------
# The workspace Cervantes builds inside this folder belongs to the AUTHOR, not
# to the kit. Ignoring it keeps a cloned install clean (`git pull` just moves
# the kit) and makes it impossible to push private drafts to a public fork by
# accident. Nothing here is tracked, so nothing here can conflict on a pull.
# ---------------------------------------------------------------------------
/CLAUDE.md
/cervantes/
/issues/
/published/

# Installed workspace skills and agents — the masters live in workspace-payload/
/.claude/skills/*
!/.claude/skills/cervantes/
/.claude/agents/

# Per-machine overrides, including the statusline written at setup
/.claude/settings.local.json
